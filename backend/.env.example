# Flask
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5001

# Security — REQUIRED in production (auto-generated in debug mode if missing).
# Generate one with: python generate_secret_key.py
# SECRET_KEY=

# Database. The default is a local SQLite file, so a fresh clone runs with no
# setup and creates the demo admin/doctor/patient accounts on first start.
# For PostgreSQL / Supabase, comment this out and use the line below instead.
DATABASE_URL=sqlite:///dev_local.db
# DATABASE_URL=postgresql+psycopg://postgres:yourpassword@127.0.0.1:5432/diabetes_expert_system

# Database behaviour (turn both off on a public deployment)
DB_AUTO_CREATE=1
SEED_DEMO_DATA=1
RULES_SEED_VERSION=v3

# Fallback to SQLite when PostgreSQL is unavailable (dev convenience)
DB_FALLBACK_ENABLED=0
DB_FALLBACK_AUTO_CREATE=1
DB_FALLBACK_SEED=1

# Connection pool tuning (optional)
# DB_POOL_SIZE=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_MAX_OVERFLOW=10

# Rate limiting (optional)
# RATELIMIT_DEFAULT=200 per minute
# RATELIMIT_STORAGE_URI=memory://

# CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Clinical report identity (optional)
# REPORT_CLINIC_NAME=General Diabetes Clinic
# REPORT_CLINIC_ADDRESS=Clinical Services Unit
# REPORT_CLINIC_PHONE=+855 00 000 000
# REPORT_CLINIC_EMAIL=clinic@example.com

# Google Authentication (OAuth 2.0 / Google Identity Services)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
